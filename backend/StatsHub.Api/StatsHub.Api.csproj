<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5a785826-9518-46ff-b714-56978da2ea55</UserSecretsId>
  </PropertyGroup>

  <!-- Memory: the host bills RAM by the minute and sees 8 cores / 8 GB, so
       .NET's defaults (a heap per core, collecting only under pressure) kept
       ~3x what this app needs. One heap, no background-collection thread,
       memory handed back eagerly; no culture data (all dates and text here
       are culture-free); no profiling of hot code for re-optimizing. -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <!-- Patched versions of packages the ones above pull in (known high-severity advisories in the older ones). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests call a few internal steps directly (e.g. IBBA auto-linking). -->
    <InternalsVisibleTo Include="StatsHub.Api.Tests" />
  </ItemGroup>

</Project>
